// The same agent role bound to different model profiles. Change the profile in
// configuration (examples/axiom.yaml), not the agent definition in source.

module examples.local_and_cloud;

import { FeatureSpec, ExecutionPlan, PatchArtifact, ReviewResult } from "./types.ax";

export enum Profile {
  Local = "local_coding",
  Hosted = "coding",
  Reasoning = "reasoning",
}

export const localProfile: Profile = Profile.Local;

export agent Architect implements Agent<FeatureSpec, ExecutionPlan> {
  purpose: "Decompose requirements and define interfaces";
  model: "reasoning";
  tools: [fs.list, fs.search, fs.read_text, artifacts.publish];
  constraints {
    must: ["Keep interfaces stable"];
    must_not: ["Modify tests"];
  }
}

export agent Reviewer implements Agent<PatchArtifact, ReviewResult> {
  purpose: "Assess artifacts against contracts";
  model: "review";
  tools: [artifacts.fetch];
}

// Instance overrides change the runtime binding only, never the agent source.
export const localArchitect = Architect.with { model: "local_coding" };
export const hostedArchitect = Architect.with { model: "coding" };
