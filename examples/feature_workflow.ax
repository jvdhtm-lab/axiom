// A hybrid workflow: deterministic steps, agent delegation, parallel work,
// a verification gate, and an approval branch. Compiled, not improvised.

integration claude_api {
  adapter: anthropic_messages
  base_url: env("ANTHROPIC_BASE_URL", "https://api.anthropic.com")
  api_key: secret("ANTHROPIC_API_KEY")
}

integration local_llm {
  adapter: openai_compatible
  base_url: env("AXIOM_LOCAL_BASE_URL", "http://localhost:11434/v1")
  api_key: secret("AXIOM_LOCAL_API_KEY", optional: true)
}

model reasoning {
  integration: "claude_api"
  model: env("CLAUDE_MODEL", "claude-model-id")
  capabilities: [chat, structured_output, tool_calling]
}

model local_coding {
  integration: "local_llm"
  model: env("AXIOM_LOCAL_MODEL", "qwen3-coder:30b")
  capabilities: [chat]
}

type FeatureSpec {
  title: String
  details: String
}

type ExecutionPlan {
  summary: String
}

type Patch {
  summary: String
}

type Review {
  approved: Bool
}

goal FeatureDelivery {
  objective: "Ship a reviewed feature behind a quality gate"
  acceptance: [
    "Runs end-to-end with mock providers",
    "A reviewer approves every artifact"
  ]
}

contract FeatureArtifact {
  inputs: { spec: "FeatureSpec" }
  outputs: { patch: "Patch" }
  invariants: ["No writes outside the declared scope"]
  acceptance: [has_tests, review_approved]
}

tool repository.read(path: String) {
  description: "Read a file from the fixture repository"
  effect: "read"
}

tool verification.tests(path: String) {
  description: "Run the acceptance checks for a path"
  effect: "read"
}

agent Architect implements Agent<FeatureSpec, ExecutionPlan> {
  model: "reasoning"
  purpose: "Plan the work and define interfaces"
}

agent Implementer implements Agent<ExecutionPlan, Patch> {
  model: "local_coding"
  purpose: "Produce a scoped artifact and nothing more"
}

agent Reviewer implements Agent<Patch, Review> {
  model: "reasoning"
  purpose: "Assess an artifact against the contract"
}

workflow feature_workflow(spec: FeatureSpec) {
  let plan = Architect(plan, spec)

  require has_steps(plan), "the plan must contain at least one step"

  parallel {
    let patch = Implementer(implement, plan)
    let tests = Implementer(tests, plan)
  }

  if review_approved(patch) {
    return patch
  } else {
    return Reviewer(review, patch)
  }
}
