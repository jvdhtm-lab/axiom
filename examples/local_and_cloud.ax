// The same agent role bound to different model integrations and profiles.
// Change the profile (configuration), not the agent definition (source).

runtime {
  default_model: "reasoning"
}

integration claude_api {
  adapter: anthropic_messages
  base_url: env("ANTHROPIC_BASE_URL", "https://api.anthropic.com")
  api_key: secret("ANTHROPIC_API_KEY")
}

integration hosted_llm {
  adapter: openai_compatible
  base_url: env("AXIOM_HOSTED_BASE_URL")
  api_key: secret("AXIOM_HOSTED_API_KEY")
  request_timeout: 90s
}

integration local_llm {
  adapter: openai_compatible
  base_url: env("AXIOM_LOCAL_BASE_URL", "http://localhost:11434/v1")
  api_key: secret("AXIOM_LOCAL_API_KEY", optional: true)
  request_timeout: 120s
}

model reasoning {
  integration: "claude_api"
  model: env("CLAUDE_MODEL", "claude-model-id")
  capabilities: [chat, structured_output, tool_calling]
}

model fast {
  integration: "hosted_llm"
  model: env("AXIOM_FAST_MODEL", "model-name")
  capabilities: [chat, structured_output]
}

model local_coding {
  integration: "local_llm"
  model: env("AXIOM_LOCAL_MODEL", "qwen3-coder:30b")
  capabilities: [chat]
}

type FeatureSpec {
  title: String
  details: String
}

type ExecutionPlan {
  summary: String
}

// `model` omitted: uses the runtime default (`reasoning`).
agent Architect implements Agent<FeatureSpec, ExecutionPlan> {
  purpose: "Decompose requirements and design interfaces"
}

agent Reviewer implements Agent<ExecutionPlan, Review> {
  model: "reasoning"
  purpose: "Assess artifacts against contracts"
}

// Instance overrides: same role, different profile.
let localArchitect = Architect.with { model: "local_coding" }
let fastReviewer = Reviewer.with { model: "fast" }
