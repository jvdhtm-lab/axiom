(* Axiom language grammar — target 1.0).

   This file is the normative grammar for Axiom 1.0 and matches the parser in
   crates/axiom-syntax. Partial semantic analysis (module graph, symbols,
   declaration/effect checks) lives in crates/axiom-types; full type checking and
   execution are not implemented yet (Phases 2+/3+). See
   docs/implementation-ledger.md for status.

   Lexical convention (agents.md §5.1): statements and member entries end with
   ";". Newlines are insignificant whitespace. The lexer still emits NEWLINE
   tokens (useful for tooling), but the parser discards them, so NEWLINE is not
   a terminator here. *)

(* ---------- lexical ---------- *)
identifier       = ( letter | "_" ), { letter | digit | "_" } ;
qualified_name   = identifier, { ".", identifier } ;
letter           = "A".."Z" | "a".."z" ;
digit            = "0".."9" ;

int_literal      = digit, { digit } ;
float_literal    = digit, { digit }, ".", digit, { digit } ;
duration_literal = int_literal, ( "ms" | "s" | "m" | "h" ) ;
size_literal     = int_literal, ( "B" | "kB" | "KB" | "MB" | "GB" | "TB"
                                 | "KiB" | "MiB" | "GiB" | "TiB" ) ;
string_literal   = '"', { string_char | escape }, '"' ;
escape           = "\", ( '"' | "\" | "n" | "r" | "t" ) ;
bool_literal     = "true" | "false" ;
null_literal     = "null" ;
literal          = int_literal | float_literal | duration_literal | size_literal
                 | string_literal | bool_literal | null_literal ;
line_comment     = "//", { any-char-except-newline } ;
block_comment    = "/*", { any-char }, "*/" ;

(* "true" / "false" / "null" are lexed as identifiers and recognised by the
   parser unless immediately followed by "(" or "." (a call or member access). *)

(* ---------- program structure ---------- *)
program          = [ module_decl ], { import_decl }, { declaration } ;
module_decl      = "module", qualified_name, terminator ;
import_decl      = "import", "{", identifier_list, "}", "from", string_literal, terminator ;
export_prefix    = [ "export" ] ;
declaration      = export_prefix,
                   ( type_decl | interface_decl | enum_decl | const_decl |
                     function_decl | agent_decl | team_decl | tool_decl |
                     contract_decl | goal_decl | policy_decl | workspace_decl |
                     workflow_decl ) ;

type_decl        = "type", identifier, [ type_parameters ], "=", type_expr, terminator ;
interface_decl   = "interface", identifier, [ type_parameters ], "{", { property_decl }, "}" ;
enum_decl        = "enum", identifier, "{", [ enum_member_list ], "}" ;
enum_member_list = enum_member, { ",", enum_member }, [ "," ] ;
enum_member      = identifier, [ "=", expression ] ;
const_decl       = ( "const" | "let", [ "mut" ] ), identifier, [ ":", type_expr ],
                   "=", expression, terminator ;
function_decl    = [ "pure" ], "fn", identifier, [ type_parameters ], "(", [ parameter_list ], ")",
                   [ "->", type_expr ], [ effect_clause ], block ;
agent_decl       = "agent", identifier, "implements", type_expr, member_block ;
team_decl        = "team", identifier, member_block ;
tool_decl        = "tool", identifier, "(", [ parameter_list ], ")", "->", type_expr,
                   effect_clause, member_block ;
contract_decl    = "contract", identifier, member_block ;
goal_decl        = "goal", identifier, "(", [ parameter_list ], ")", "->", type_expr, member_block ;
policy_decl      = "policy", identifier, member_block ;
workspace_decl   = "workspace", identifier, member_block ;
workflow_decl    = "workflow", identifier, "(", [ parameter_list ], ")", [ "->", type_expr ], block ;

(* Member blocks are shared by agent / team / tool / contract / goal / policy /
   workspace bodies. Entries end with ";" except a nested block, whose closing
   "}" acts as the separator (a trailing ";" is still accepted). *)
member_block     = "{", { member }, "}" ;
member           = identifier, [ member_label ],
                   ( ":" , expression, terminator
                   | member_block, [ ";" ]
                   | "->", expression, terminator ) ;
member_label     = identifier | string_literal ;   (* postcondition non_empty: ...; *)

effect_clause    = "effects", "[", [ effect_list ], "]" ;
effect_list      = effect_name, { ",", effect_name }, [ "," ] ;
effect_name      = qualified_name ;               (* fs.read, model, artifact, ... *)

(* ---------- statements ---------- *)
block            = "{", { statement | declaration }, "}" ;
statement        = binding_stmt | assignment_stmt | if_stmt | match_stmt | for_stmt |
                   while_stmt | return_stmt | yield_stmt | break_stmt | continue_stmt |
                   throw_stmt | try_stmt | require_stmt | parallel_stmt | retry_stmt |
                   timeout_stmt | on_error_stmt | checkpoint_stmt | emit_stmt |
                   expression_stmt ;
binding_stmt     = ( "let", [ "mut" ] | "const" ), identifier, [ ":", type_expr ],
                   "=", expression, terminator ;
assignment_stmt  = assignable, assignment_operator, expression, terminator ;
if_stmt          = "if", expression, block, [ "else", ( block | if_stmt ) ] ;
match_stmt       = "match", expression, "{", { match_arm }, "}" ;
match_arm        = pattern, "=>", ( expression | block ), [ "," ] ;
for_stmt         = "for", identifier, "in", expression, block ;
while_stmt       = "while", expression, [ "max", expression ], block ;
return_stmt      = "return", [ expression ], terminator ;
yield_stmt       = "yield", [ expression ], terminator ;
break_stmt       = "break", terminator ;
continue_stmt    = "continue", terminator ;
throw_stmt       = "throw", expression, terminator ;
try_stmt         = "try", block, { "catch", [ "(", identifier, ")" ], block }, [ "finally", block ] ;
require_stmt     = "require", expression,
                   [ "else", ( "escalate", expression | expression ) ], terminator ;
parallel_stmt    = "parallel", "for", identifier, "in", expression, [ "max", expression ], block ;
retry_stmt       = "retry", expression, block ;
timeout_stmt     = "timeout", expression, block ;
on_error_stmt    = "on_error", "(", parameter, ")", block ;
checkpoint_stmt  = "checkpoint", [ expression ], terminator ;
emit_stmt        = "emit", expression, terminator ;
expression_stmt  = expression, terminator ;

assignable       = qualified_name, { "[", expression, "]" | ".", identifier } ;
assignment_operator = "=" | "+=" | "-=" | "*=" | "/=" ;
pattern          = "_" | identifier | literal | "(" , pattern_list, ")" ;
pattern_list     = pattern, { ",", pattern } ;

(* ---------- expressions ---------- *)
expression       = conditional_expr ;
conditional_expr = binary_expr, [ "?", expression, ":", expression ] ;
binary_expr      = unary_expr, { binary_operator, unary_expr } ;
unary_expr       = [ unary_operator ], postfix_expr ;
postfix_expr     = primary_expr, { member_access | index_access | call_suffix | with_suffix } ;
primary_expr     = literal | identifier | list_literal | object_literal |
                   lambda_expr | simple_lambda | await_expr | delegate_expr |
                   parallel_expr | "(", expression, ")" ;
await_expr       = "await", unary_expr ;
delegate_expr    = "delegate", qualified_name, "(", [ argument_list ], ")" ;
                   (* the qualified name's final segment is the method *)
parallel_expr    = "parallel", "for", identifier, "in", expression, [ "max", expression ], block ;
list_literal     = "[", [ argument_list ], "]" ;
object_literal   = "{", [ object_entry_list ], "}" ;
object_entry_list= object_entry, { ( "," | ";" ), object_entry }, [ "," | ";" ] ;
object_entry     = ( identifier | string_literal ), ":", expression ;
lambda_expr      = "(", [ parameter_list ], ")", "=>", ( expression | block ) ;
simple_lambda    = identifier, "=>", ( expression | block ) ;
member_access    = ".", identifier ;
with_suffix      = ".", "with", object_literal ;        (* Agent.with { ... } sugar *)
index_access     = "[", expression, "]" ;
call_suffix      = "(", [ argument_list ], ")" ;
argument_list    = argument, { ",", argument }, [ "," ] ;
argument         = [ identifier, ":" ], expression ;

unary_operator   = "!" | "-" | "+" ;                     (* precedence: highest *)
binary_operator  = "*" | "/" | "%"                       (* higher than + - *)
                 | "+" | "-"
                 | "<" | "<=" | ">" | ">="
                 | "==" | "!="
                 | "&&"
                 | "||" ;                                (* lowest, left-assoc *)

(* ---------- types ---------- *)
type_expr        = union_type ;
union_type       = generic_type, { "|", generic_type } ;
generic_type     = ref_type | "[", type_expr, "]" | "{", [ property_type_list ], "}"
                 | string_literal ;
ref_type         = qualified_name, [ "<", type_argument_list, ">" ], { "[", "]" } ;
(* `T[]` is the normative suffix array form; `[T]` is accepted as a legacy prefix form. *)
type_argument_list = type_expr, { ",", type_expr }, [ "," ] ;
property_type_list = property_type, { ( "," | ";" ), property_type }, [ "," | ";" ] ;
property_type    = identifier, [ "?" ], ":", type_expr ;
property_decl    = identifier, [ "?" ], ":", type_expr, terminator ;
parameter        = identifier, [ "?" ], [ ":", type_expr ], [ "=", expression ] ;
type_parameters  = "<", identifier_list, ">" ;
parameter_list   = parameter, { ",", parameter }, [ "," ] ;
identifier_list  = identifier, { ",", identifier }, [ "," ] ;
terminator       = ";" ;
