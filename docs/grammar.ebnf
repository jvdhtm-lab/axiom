(* Axiom language grammar — target 1.0.

   Normative grammar for the small Axiom 1.0 language. It matches the parser in
   crates/axiom-syntax. The declaration forms are exactly the ones named in
   agents.md §3.3: module, import, export, type, enum, fn, agent, workspace, plus
   the `api` and `async` function modifiers and the `effects` clause. There are
   deliberately no other declaration keywords: agent iteration, validation,
   caching, persistence, retries, checkpoints, database queries, tools, artifact
   publishing, and parallel work are standard-library calls or `axiom.yaml`
   configuration, not grammar.

   Lexical convention: statements and member entries end with ";". Newlines are
   insignificant whitespace. The lexer still emits NEWLINE tokens (useful for
   tooling), but the parser discards them. A closing "}" may act as the final
   separator of a block. *)

(* ---------- lexical ---------- *)
identifier       = ( letter | "_" ), { letter | digit | "_" } ;
qualified_name   = identifier, { ".", identifier } ;
letter           = "A".."Z" | "a".."z" ;
digit            = "0".."9" ;

int_literal      = digit, { digit } ;
float_literal    = digit, { digit }, ".", digit, { digit } ;
duration_literal = int_literal, ( "ms" | "s" | "m" | "h" ) ;
size_literal     = int_literal, ( "B" | "kB" | "KB" | "MB" | "GB" | "TB"
                                 | "KiB" | "MiB" | "GiB" | "TiB" ) ;
string_literal   = '"', { string_char | escape }, '"' ;
escape           = "\", ( '"' | "\" | "n" | "r" | "t" ) ;
bool_literal     = "true" | "false" ;
literal          = int_literal | float_literal | duration_literal | size_literal
                 | string_literal | bool_literal ;
line_comment     = "//", { any-char-except-newline } ;
block_comment    = "/*", { any-char }, "*/" ;

(* "true" / "false" are lexed as identifiers and recognised by the parser unless
   immediately followed by "(" or "." (a call or member access). `None`, `Some`,
   `Ok`, and `Err` are prelude constructors, also lexed as identifiers. *)

(* ---------- program structure ---------- *)
program          = [ module_decl ], { import_decl }, { declaration } ;
module_decl      = "module", qualified_name, ";" ;
import_decl      = "import", "{", identifier_list, "}", "from", string_literal, ";" ;
declaration      = [ "export" ],
                   ( type_decl | enum_decl | function_decl | agent_decl | workspace_decl ) ;

(* ---------- type / enum declarations ---------- *)
type_decl        = "type", identifier, [ type_parameters ], "=", type_expr, ";" ;
enum_decl        = "enum", identifier, "{", [ enum_member_list ], "}" ;
enum_member_list = identifier, { ( ";" | "," ), identifier }, [ ";" | "," ] ;

(* ---------- functions ---------- *)
function_decl    = [ "api" ], [ "async" ], "fn", identifier, [ type_parameters ],
                   "(", [ parameter_list ], ")", [ "->", type_expr ],
                   [ effect_clause ], block ;
effect_clause    = "effects", "[", [ effect_list ], "]" ;
effect_list      = effect_name, { ",", effect_name }, [ "," ] ;
effect_name      = qualified_name ;

(* ---------- agents and workspaces (metadata member blocks) ---------- *)
agent_decl       = "agent", identifier, "(", [ parameter_list ], ")", "->", type_expr,
                   member_block ;
workspace_decl   = "workspace", identifier, member_block ;

(* Member blocks carry declaration metadata as name/value entries. A nested
   "{ ... }" is an object value. Entries end with ";" or ","; the closing "}"
   may serve as the final separator. *)
member_block     = "{", { member_entry }, "}" ;
member_entry     = identifier, ":", expression, ( ";" | "," | "}"-lookahead ) ;

(* ---------- statements ---------- *)
block            = "{", { statement }, "}" ;
statement        = binding_stmt | if_stmt | match_stmt | for_stmt | return_stmt |
                   expression_stmt ;
binding_stmt     = "let", identifier, [ ":", type_expr ], "=", expression, ";" ;
if_stmt          = "if", expression, block, [ "else", ( block | if_stmt ) ] ;
match_stmt       = "match", expression, "{", { match_arm }, "}" ;
match_arm        = pattern, "=>", ( block | expression ), ( ";" | "," ) ;
for_stmt         = "for", identifier, "in", expression, block ;
return_stmt      = "return", [ expression ], ";" ;
expression_stmt  = expression, ";" ;

pattern          = "_" | literal | qualified_pattern | "(" , pattern_list, ")" ;
qualified_pattern= identifier, { ".", identifier }, [ "(", [ pattern_list ], ")" ] ;
pattern_list     = pattern, { ",", pattern }, [ "," ] ;

(* ---------- expressions ---------- *)
expression       = or_expr ;
or_expr          = and_expr, { "||", and_expr } ;
and_expr         = equality_expr, { "&&", equality_expr } ;
equality_expr    = comparison_expr, { ( "==" | "!=" ), comparison_expr } ;
comparison_expr  = additive_expr, { ( "<" | "<=" | ">" | ">=" ), additive_expr } ;
additive_expr    = multiplicative_expr, { ( "+" | "-" ), multiplicative_expr } ;
multiplicative_expr = unary_expr, { ( "*" | "/" | "%" ), unary_expr } ;
unary_expr       = [ ( "!" | "-" ) ], postfix_expr ;

postfix_expr     = primary_expr, { member_access | index_access | generic_call | call_suffix } ;
member_access    = ".", identifier ;
index_access     = "[", expression, "]" ;
generic_call     = "<", type_argument_list, ">", call_suffix ;   (* f<T>(...) *)
call_suffix      = "(", [ argument_list ], ")" ;

primary_expr     = literal | if_expr | match_expr | await_expr | identifier |
                   list_literal | object_literal | "(", expression, ")" ;
if_expr          = "if", expression, block, [ "else", ( block | if_expr ) ] ;
match_expr       = match_stmt ;
await_expr       = "await", unary_expr ;
list_literal     = "[", [ argument_list ], "]" ;
object_literal   = "{", [ object_entry_list ], "}" ;
object_entry_list= object_entry, { ( "," | ";" ), object_entry }, [ "," | ";" ] ;
object_entry     = identifier, ":", expression ;

argument_list    = argument, { ",", argument }, [ "," ] ;
argument         = [ identifier, ":" ], expression ;

(* ---------- types ---------- *)
type_expr        = primary_type ;
primary_type     = ref_type, { "[", "]" } | record_type | "(", type_expr, ")" ;
ref_type         = qualified_name, [ "<", type_argument_list, ">" ] ;
record_type      = "{", [ field_type_list ], "}" ;
field_type_list  = field_type, { ( ";" | "," ), field_type }, [ ";" | "," ] ;
field_type       = identifier, ":", type_expr ;
type_argument_list = type_expr, { ",", type_expr }, [ "," ] ;
type_parameters  = "<", identifier_list, ">" ;
parameter        = identifier, ":", type_expr ;
parameter_list   = parameter, { ",", parameter }, [ "," ] ;
identifier_list  = identifier, { ",", identifier }, [ "," ] ;

(* ---------- operators (precedence, tightest first) ----------
   postfix (call, member, index)
   unary   ! -
   * / %
   + -
   < <= > >=
   == !=
   &&
   ||
   *)

(* Reserved / rejected forms. The following are intentionally NOT part of the
   grammar and must be diagnosed as unsupported with a stable error code:
   interface, const, let mut, while, throw, try/catch/finally, yield, require,
   parallel for, retry, timeout, on_error, checkpoint, emit, delegate, iterate,
   lambda/arrow expressions, tuple types, `with` sugar, `query`, `operation`,
   `team`, `goal`, `task`, `contract`, `policy`, `tool`, `workflow`, `state`,
   `store`, `transition`, `migration`, and general reassignment (+=, -=, ...). *)
